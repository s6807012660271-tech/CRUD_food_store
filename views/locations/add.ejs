<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <nav class="nav">
            <a href="/">Foods</a>
            <a href="/locations">Delivery Locations</a>
            <a href="/orders">Orders</a>
        </nav>
        <h1><%= title %></h1>

        <% if (foods.length === 0) { %>
            <p class="empty">You need at least one food item before adding a delivery location. <a href="/add">Add a food first</a>.</p>
        <% } else { %>
        <form action="/locations/add" method="POST" class="food-form">
            <label for="food_id">Food</label>
            <select id="food_id" name="food_id" required>
                <% foods.forEach(food => { %>
                    <option value="<%= food.id %>"><%= food.food_name %></option>
                <% }) %>
            </select>

            <label for="location_name">Location Name</label>
            <input type="text" id="location_name" name="location_name" placeholder="e.g. Downtown Branch" required>

            <label for="address">Address</label>
            <input type="text" id="address" name="address" placeholder="Delivery address / area" required>

            <label for="delivery_fee">Delivery Fee</label>
            <input type="number" id="delivery_fee" name="delivery_fee" step="0.01" min="0" value="0">

            <div class="form-actions">
                <button type="submit" class="btn btn-add">Add Location</button>
                <a class="btn btn-cancel" href="/locations">Cancel</a>
            </div>
        </form>
        <% } %>
    </div>
</body>
</html>
