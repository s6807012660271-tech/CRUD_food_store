<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <nav class="nav">
            <a href="/">Foods</a>
            <a href="/locations">Delivery Locations</a>
            <a href="/orders">Orders</a>
        </nav>
        <h1><%= title %></h1>
        <form action="/locations/edit/<%= location.id %>?_method=PUT" method="POST" class="food-form">
            <label for="food_id">Food</label>
            <select id="food_id" name="food_id" required>
                <% foods.forEach(food => { %>
                    <option value="<%= food.id %>" <%= food.id === location.food_id ? 'selected' : '' %>><%= food.food_name %></option>
                <% }) %>
            </select>

            <label for="location_name">Location Name</label>
            <input type="text" id="location_name" name="location_name" value="<%= location.location_name %>" required>

            <label for="address">Address</label>
            <input type="text" id="address" name="address" value="<%= location.address %>" required>

            <label for="delivery_fee">Delivery Fee</label>
            <input type="number" id="delivery_fee" name="delivery_fee" step="0.01" min="0" value="<%= location.delivery_fee %>">

            <div class="form-actions">
                <button type="submit" class="btn btn-edit">Save Changes</button>
                <a class="btn btn-cancel" href="/locations">Cancel</a>
            </div>
        </form>
    </div>
</body>
</html>
