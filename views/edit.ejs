<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <nav class="nav">
            <a href="/">Foods</a>
            <a href="/locations">Delivery Locations</a>
            <a href="/orders">Orders</a>
        </nav>
        <h1><%= title %></h1>
        <form action="/edit/<%= food.id %>?_method=PUT" method="POST" class="food-form">
            <label for="food_name">Food Name</label>
            <input type="text" id="food_name" name="food_name" value="<%= food.food_name %>" required>

            <label for="food_type">Food Type</label>
            <input type="text" id="food_type" name="food_type" value="<%= food.food_type %>" required>

            <label for="price">Price</label>
            <input type="number" id="price" name="price" step="0.01" min="0" value="<%= food.price %>" required>

            <div class="form-actions">
                <button type="submit" class="btn btn-edit">Save Changes</button>
                <a class="btn btn-cancel" href="/">Cancel</a>
            </div>
        </form>
    </div>
</body>
</html>
