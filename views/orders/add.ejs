<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <nav class="nav">
            <a href="/">Foods</a>
            <a href="/locations">Delivery Locations</a>
            <a href="/orders">Orders</a>
        </nav>
        <h1><%= title %></h1>

        <% if (foods.length === 0 || locations.length === 0) { %>
            <p class="empty">You need at least one food item and one delivery location before adding an order.</p>
        <% } else { %>
        <form action="/orders/add" method="POST" class="food-form">
            <label for="customer_name">Customer Name</label>
            <input type="text" id="customer_name" name="customer_name" required>

            <label for="food_id">Food</label>
            <select id="food_id" name="food_id" required>
                <% foods.forEach(food => { %>
                    <option value="<%= food.id %>"><%= food.food_name %> ($<%= Number(food.price).toFixed(2) %>)</option>
                <% }) %>
            </select>

            <label for="location_id">Delivery Location</label>
            <select id="location_id" name="location_id" required>
                <% locations.forEach(loc => { %>
                    <option value="<%= loc.id %>"><%= loc.location_name %> — <%= loc.address %></option>
                <% }) %>
            </select>

            <label for="quantity">Quantity</label>
            <input type="number" id="quantity" name="quantity" min="1" value="1" required>

            <label for="status">Status</label>
            <select id="status" name="status">
                <option value="Pending">Pending</option>
                <option value="Preparing">Preparing</option>
                <option value="Delivering">Delivering</option>
                <option value="Delivered">Delivered</option>
                <option value="Cancelled">Cancelled</option>
            </select>

            <div class="form-actions">
                <button type="submit" class="btn btn-add">Add Order</button>
                <a class="btn btn-cancel" href="/orders">Cancel</a>
            </div>
        </form>
        <% } %>
    </div>
</body>
</html>
